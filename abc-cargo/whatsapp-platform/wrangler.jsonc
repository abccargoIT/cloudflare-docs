{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abc-cargo-whatsapp-platform",
	"main": "src/index.ts",
	// Must not run ahead of the runtime the pinned wrangler ships: a later date
	// makes `wrangler dev` refuse to start with "newest date supported by this
	// server binary". Raise this and the wrangler version together.
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat"],
	// Keep the workers.dev preview URL disabled. The Meta webhook callback
	// URL has to be stable, so the Worker is reached through a custom
	// hostname rather than a workers.dev address.
	"workers_dev": false,
	// The webhook hostname. The zone is active in the ABC Cargo Cloudflare
	// account and engage.abccargosupport.com already resolves through the
	// Cloudflare proxy, held open by a placeholder A record to 192.0.2.0.
	//
	// On deploy, Cloudflare attaches this Worker as the Custom Domain and
	// manages the DNS record and certificate itself. The placeholder is an A
	// record, not a CNAME, precisely so it does not block that step.
	//
	// A deploy still needs the account resources below to exist first:
	// the D1 database (and its id filled in), the R2 bucket, and both queues.
	"routes": [
		{
			// CAREFUL: this hostname is currently served by the demonstration
			// Worker (`wrangler.demo.jsonc`, `abc-cargo-engage-demo`). Deploying
			// this configuration takes the hostname over and replaces the
			// demonstration with the full platform — including the Meta webhook
			// route — on a public URL. Do that deliberately, not by running
			// `wrangler deploy` in this directory out of habit.
			"pattern": "engage.abccargosupport.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"vars": {
		// Meta Graph API version. Confirm the current supported version in
		// the Meta for Developers changelog before deploying.
		"GRAPH_API_VERSION": "v21.0",
		// One entry per WhatsApp phone number attached to the ABC Cargo WABA.
		//
		// phoneNumberId is the numeric "Phone number ID" from Meta Business Suite
		// > WhatsApp Manager > Phone numbers. It is an identifier, not a secret,
		// and is supplied at go-live after the pre-cutover checks. Each is a
		// DISTINCT placeholder until then: three identical ones are refused as
		// duplicates, and that refusal makes every /api/* route answer 500.
		//
		// businessHours: all seven days, 08:00 to 23:00 local, every region.
		// Confirmed by the Head of IT on 8 October 2026.
		//
		// THESE ARE THE WHATSAPP DESK HOURS, NOT THE OFFICE WEEK. The offices
		// work UAE and KSA Sunday to Thursday, UK Monday to Friday. The desk is
		// covered all seven days, which is why this says seven. Anyone later
		// "correcting" these to the office week would make the platform tell
		// customers the desk is shut on days it is staffed, and stop the service
		// clocks running while agents are answering.
		//
		// days: 0 = Sunday ... 6 = Saturday. `end` is exclusive, so 23:00 means
		// open up to 22:59 and closed from 23:00. The out-of-hours automated
		// reply therefore fires only overnight, 23:00 to 08:00 in each region.
		"REGION_NUMBERS": "[{\"id\":\"uae\",\"label\":\"UAE\",\"phoneNumberId\":\"REPLACE_AT_GO_LIVE_UAE\",\"displayNumber\":\"+971800916\",\"timezone\":\"Asia/Dubai\",\"language\":\"en\",\"businessHours\":{\"days\":[0,1,2,3,4,5,6],\"start\":\"08:00\",\"end\":\"23:00\"}},{\"id\":\"ksa\",\"label\":\"KSA\",\"phoneNumberId\":\"REPLACE_AT_GO_LIVE_KSA\",\"displayNumber\":\"+966548454866\",\"timezone\":\"Asia/Riyadh\",\"language\":\"ar\",\"businessHours\":{\"days\":[0,1,2,3,4,5,6],\"start\":\"08:00\",\"end\":\"23:00\"}},{\"id\":\"uk\",\"label\":\"UK\",\"phoneNumberId\":\"REPLACE_AT_GO_LIVE_UK\",\"displayNumber\":\"+447388800000\",\"timezone\":\"Europe/London\",\"language\":\"en\",\"businessHours\":{\"days\":[0,1,2,3,4,5,6],\"start\":\"08:00\",\"end\":\"23:00\"}}]",
		// Hours after an automated reply before another one may be sent to
		// the same customer while no agent is available.
		"AUTO_REPLY_COOLDOWN_HOURS": "12",
		// Public tracking page shown in automated replies. Optional.
		"TRACKING_URL": "",
		// Serve the offline demonstration at / so the hostname is usable for
		// testing before any Meta credential exists. Set to "false" before the
		// first live number is cut over: the demonstration carries invented
		// customer data and has no place on a production endpoint.
		"SERVE_DEMO": "true",
		// Whether this deployment may actually send broadcasts.
		//
		// "false" here, and that is deliberate. Broadcasts are the one thing in
		// this platform that reaches thousands of real customers from a single
		// action, so turning them on is a separate decision from deploying the
		// Worker. With this unset or anything other than "true", an approved
		// broadcast will not dispatch a single message and the pacer does
		// nothing.
		"BROADCASTS_ENABLED": "false",
	},
	// Secrets are NOT stored here. Set them with `wrangler secret put <NAME>`:
	//   WHATSAPP_ACCESS_TOKEN  - permanent System User token (whatsapp_business_messaging,
	//                            whatsapp_business_management)
	//   WHATSAPP_APP_SECRET    - Meta App secret, used to verify X-Hub-Signature-256
	//   WHATSAPP_VERIFY_TOKEN  - random string entered in the Meta webhook configuration
	//   INTERNAL_API_KEY       - bearer key for the /api/* agent endpoints
	// Lets the Worker bundle demo/app.html as a string, so the demonstration
	// can be served from the webhook hostname without a separate host. See
	// SERVE_DEMO below.
	"rules": [{ "type": "Text", "globs": ["**/*.html"] }],
	"durable_objects": {
		"bindings": [{ "name": "CONVERSATION", "class_name": "Conversation" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
	// The broadcast pacer. A campaign of several thousand cannot be sent inside
	// the request that pressed Send, so Send only marks the broadcast as
	// sending and this dispatches a paced batch each minute. It does nothing
	// unless BROADCASTS_ENABLED is "true", which is not the default.
	"triggers": { "crons": ["* * * * *"] },
	"queues": {
		"producers": [
			{ "binding": "WEBHOOK_QUEUE", "queue": "abc-whatsapp-webhooks" },
		],
		"consumers": [
			{
				"queue": "abc-whatsapp-webhooks",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 5,
				"dead_letter_queue": "abc-whatsapp-webhooks-dlq",
			},
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "abc-whatsapp",
			// Fill in after `wrangler d1 create abc-whatsapp`.
			"database_id": "REPLACE_AFTER_D1_CREATE",
			"migrations_dir": "src/db/migrations",
		},
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "abc-whatsapp-media" }],
	// Optional: enable Workers AI for intent classification and reply drafting.
	// "ai": { "binding": "AI" },
}
